<odoo>
    <record id="view_work_entry_form_inherit_attendance" model="ir.ui.view">
        <field name="name">hr.work.entry.form.inherit.attendance</field>
        <field name="model">hr.work.entry</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_from_attendance"
                        string="Generate from Attendance"
                        type="object"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>
